---
import services from '../content/services.json';
const { process } = services;
---
<div class="process">
  <div class="process__head">
    <p class="label-s">{process.label}</p>
    <p class="process__title">{process.title}</p>
  </div>
  <ol class="process__steps">
    {process.steps.map((step) => (
      <li class:list={['process__step', step.ai && 'process__step--ai']}>
        <span class="process__label">{step.label}</span>
        <span class="process__step-title">{step.title}</span>
        <span class="process__text">{step.text}</span>
      </li>
    ))}
  </ol>
</div>

<style>
  .process {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .process__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
  }
  .process__head .label-s { letter-spacing: .2em; }
  .process__title {
    font-size: 18px;
    font-weight: 600;
  }
  .process__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 40px;
    align-items: stretch;
  }
  .process__step {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .process__step--ai { border-color: var(--state); }
  .process__label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .2em;
    color: var(--accent);
  }
  .process__step--ai .process__label { color: var(--state); }
  .process__step-title {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
  }
  .process__text {
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-2);
  }
  .process__step + .process__step::before {
    content: '→' / '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -41px;
    width: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-2);
    font-size: 20px;
  }

  @media (max-width: 767px) {
    .process { gap: 20px; }
    .process__head {
      flex-direction: column;
      gap: 20px;
      margin-top: 16px;
    }
    .process__head .label-s { letter-spacing: .18em; }
    .process__steps {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 32px;
    }
    .process__step { padding: 20px; gap: 6px; }
    .process__label { letter-spacing: .18em; }
    .process__step-title { font-size: 19px; }
    .process__step + .process__step::before {
      content: '↓' / '';
      top: -33px;
      bottom: auto;
      left: 0;
      right: 0;
      width: auto;
      height: 32px;
      font-size: 18px;
    }
  }
</style>
