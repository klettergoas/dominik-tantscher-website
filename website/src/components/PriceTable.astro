---
import preise from '../content/preise.json';
const p = preise.packages;
---
<div class="prices" role="table" aria-label="Leistungspakete mit Preis">
  <div class="prices__row prices__row--head" role="row">
    <div class="prices__head-service" role="columnheader">{p.headService}</div>
    <div class="prices__head-price" role="columnheader">{p.headPrice}</div>
  </div>
  {p.items.map((pk) => (
    <div class="prices__row" role="row">
      <div class="prices__service" role="cell">
        <span class="prices__n">{pk.n}</span>
        <div class="prices__desc">
          <h3 class="prices__title">{pk.title}</h3>
          <p class="prices__text">{pk.text}</p>
        </div>
      </div>
      <div class="prices__cell" role="cell">
        <span class="prices__mlabel">{p.headPrice}</span>
        {pk.prices.map((pr) => (
          <span class="prices__option">
            <span class="prices__amount">{pr.pre && <span class="prices__pre">{pr.pre}</span>}<span class="prices__value">{pr.value}</span></span>
            <span class="prices__unit">{pr.label}</span>
          </span>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .prices {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    --col-price: 240px;
  }
  .prices__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--col-price);
    border-bottom: 1px solid var(--border);
  }
  .prices__row:last-child { border-bottom: 0; }
  .prices__row--head {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .2em;
    color: var(--text-2);
  }
  .prices__head-service { padding: 18px 0 18px 28px; }
  .prices__head-price {
    padding: 18px 28px;
    border-left: 1px solid var(--border);
  }
  .prices__service {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
  }
  .prices__n {
    padding: 32px 0 32px 28px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-2);
  }
  .prices__desc {
    padding: 32px 40px 32px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .prices__title {
    font-size: 26px;
    line-height: 1.2;
  }
  .prices__text {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .prices__cell {
    padding: 32px 28px;
    border-left: 1px solid var(--border);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .prices__mlabel { display: none; }
  /* mehrere Formate je Paket (z. B. Schulung: 90 Minuten / Halbtag) untereinander */
  .prices__option {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .prices__option + .prices__option {
    margin-top: 12px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }
  .prices__amount {
    display: flex;
    align-items: baseline;
    gap: 6px;
    color: var(--accent);
  }
  .prices__pre {
    font-size: 18px;
    font-weight: 600;
  }
  .prices__value {
    font-size: 36px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -.01em;
    white-space: nowrap;
  }
  .prices__unit {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .18em;
    color: var(--text);
  }

  @media (max-width: 1279px) {
    .prices { --col-price: 200px; }
    .prices__n { padding-left: 24px; }
    .prices__service { grid-template-columns: 60px minmax(0, 1fr); }
    .prices__head-service { padding-left: 24px; }
    .prices__desc { padding-right: 28px; }
    .prices__cell, .prices__head-price { padding-left: 24px; padding-right: 24px; }
    .prices__value { font-size: 32px; }
  }

  /* Mobil: gestapelt – Titel, Text, darunter der Preis */
  @media (max-width: 767px) {
    .prices__row--head { display: none; }
    .prices__row { grid-template-columns: minmax(0, 1fr); }
    .prices__service {
      grid-template-columns: minmax(0, 1fr);
      padding: 24px 20px;
      gap: 8px;
    }
    .prices__n { padding: 0; font-size: 13px; }
    .prices__desc { padding: 0; gap: 10px; }
    .prices__title { font-size: 22px; }
    .prices__cell {
      padding: 20px;
      border-left: 0;
      border-top: 1px solid var(--border);
    }
    .prices__mlabel {
      display: block;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: .18em;
      color: var(--text-2);
    }
    .prices__value { font-size: 28px; }
    .prices__pre { font-size: 16px; }
    .prices__unit { font-size: 11px; letter-spacing: .14em; }
  }
</style>
