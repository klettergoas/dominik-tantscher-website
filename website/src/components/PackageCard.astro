---
// Paket-Karte mit Preis. Daten ausschließlich aus src/content/preise.json.
import preise from '../content/preise.json';

type Package = (typeof preise.packages.items)[number];
interface Props { pk: Package }
const { pk } = Astro.props;
const p = preise.packages;
---
<article class="card package">
  <div class="package__head">
    <span class="package__n" aria-hidden="true">{pk.n}</span>
    <h3 class="package__title">{pk.title}</h3>
  </div>
  <p class="package__text">{pk.text}</p>
  <dl class="package__prices">
    <div class="package__price">
      <dt>{p.headPrice}</dt>
      {pk.prices.map((pr) => (
        <dd>
          <span class="package__amount">{pr.pre && <span class="package__pre">{pr.pre}</span>}<span class="package__value">{pr.value}</span></span>
          <span class="package__unit">{pr.label}</span>
        </dd>
      ))}
    </div>
  </dl>
  <slot />
</article>

<style>
  .package {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .package__head {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }
  .package__n {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-2);
  }
  .package__title {
    font-size: 26px;
    line-height: 1.2;
  }
  .package__text {
    flex: 1;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .package__prices {
    margin: 0;
    border: 1px solid var(--border);
  }
  .package__price {
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--bg);
  }
  .package__price dt {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .18em;
    color: var(--text-2);
  }
  .package__price dd {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .package__price dd + dd {
    margin-top: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .package__amount {
    display: flex;
    align-items: baseline;
    gap: 6px;
    color: var(--accent);
  }
  .package__pre {
    font-size: 16px;
    font-weight: 600;
  }
  .package__value {
    font-size: 30px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -.01em;
    white-space: nowrap;
  }
  .package__unit {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .16em;
    color: var(--text);
  }

  @media (max-width: 767px) {
    .package { padding: 24px 20px; gap: 16px; }
    .package__title { font-size: 22px; }
    .package__price { padding: 16px; }
    .package__value { font-size: 26px; }
  }
</style>
