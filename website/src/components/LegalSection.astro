---
type Block = {
  p?: string;
  sub?: string;
  lines?: string[];
  list?: string[];
  defs?: { k: string; v: string }[];
};
interface Props { n: string; title: string; blocks: Block[] }
const { n, title, blocks } = Astro.props;
---
<section class="legal grid" aria-labelledby={`ds-${n}`}>
  <p class="label legal__n" aria-hidden="true">{n}</p>
  <div class="legal__body">
    <h2 id={`ds-${n}`} class="legal__title">{title}</h2>
    {blocks.map((b) => (
      b.p ? <p class="legal__p">{b.p}</p>
      : b.sub ? <h3 class="legal__sub">{b.sub}</h3>
      : b.lines ? <p class="legal__lines">{b.lines.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>
      : b.list ? <ul class="legal__list">{b.list.map((li) => <li>{li}</li>)}</ul>
      : b.defs ? <dl class="legal__defs">{b.defs.map((d) => <div><dt>{d.k}</dt><dd>{d.v}</dd></div>)}</dl>
      : null
    ))}
  </div>
</section>

<style>
  .legal {
    padding: 48px 0;
    border-top: 1px solid var(--border);
  }
  .legal__n {
    grid-column: 1 / span 3;
    padding-top: 8px;
  }
  .legal__body {
    grid-column: 4 / span 8;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .legal__title {
    font-size: 28px;
    line-height: 1.2;
  }
  .legal__sub {
    margin-top: 12px;
    font-size: 20px;
    line-height: 1.3;
  }
  .legal__p {
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-2);
  }
  .legal__lines {
    font-size: 17px;
    line-height: 1.6;
  }
  .legal__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .legal__list li {
    display: flex;
    gap: 14px;
    align-items: baseline;
    font-size: 17px;
    line-height: 1.55;
  }
  .legal__list li::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--accent);
    transform: translateY(-2px);
  }
  .legal__defs {
    margin: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }
  .legal__defs div {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 24px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }
  .legal__defs dt {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .18em;
    color: var(--text-2);
    padding-top: 3px;
  }
  .legal__defs dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
  }
  @media (max-width: 1023px) {
    .legal__n { grid-column: 1 / span 2; }
    .legal__body { grid-column: 3 / span 10; }
  }
  @media (max-width: 767px) {
    .legal { padding: 40px 0; gap: 12px; }
    .legal__n { padding-top: 0; }
    .legal__title { font-size: 24px; }
    .legal__p, .legal__lines, .legal__list li { font-size: 16px; }
    .legal__defs div {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }
  }
</style>
