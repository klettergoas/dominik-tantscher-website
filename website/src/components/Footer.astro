---
import site from '../content/site.json';
import { nbsp } from '../lib/format';
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__contact">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.phoneHref}>{nbsp(site.phone)}</a>
    </div>
    <div class="site-footer__meta">
      <div class="site-footer__legal">
        <a href="/impressum">IMPRESSUM</a>
        <a href="/datenschutz">DATENSCHUTZ</a>
      </div>
      <span class="site-footer__name">DOMINIK TANTSCHER</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  .site-footer__inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 40px var(--pad-x);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: .08em;
    color: var(--text-2);
  }
  .site-footer__contact, .site-footer__meta, .site-footer__legal {
    display: flex;
    gap: 24px;
    align-items: center;
  }
  .site-footer__contact a { color: var(--text); }
  .site-footer__contact a:hover { color: var(--accent); }
  .site-footer__legal a { color: var(--text-2); }
  .site-footer__legal a:hover { color: var(--text); }
  .site-footer__name { letter-spacing: .2em; }

  @media (max-width: 767px) {
    .site-footer__inner {
      padding: 32px var(--pad-x);
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .site-footer__contact {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
    .site-footer__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .site-footer a { padding: 10px 0; }
  }
</style>
