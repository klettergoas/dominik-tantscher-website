---
import '../styles/global.css';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import site from '../content/site.json';

interface Props {
  title: string;
  description?: string;
  active?: string;
  noindex?: boolean;
  canonical?: boolean;
}

const { title, description, active = 'none', noindex = false, canonical = true } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '').replace(/\.html$/, '').replace(/\/index$/, '');
const canonicalUrl = site.url + (path === '' ? '/' : path);
const ogImage = site.url + '/og-image.png';
---
<!doctype html>
<html lang="de-AT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonicalUrl} />}
    <meta name="theme-color" content="#0A0C11" />
    <link rel="preload" href="/fonts/archivo-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_AT" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} – ${site.claim}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">ZUM INHALT</a>
    <Header active={active} />
    <MobileMenu active={active} />
    <main id="inhalt" class="page" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
