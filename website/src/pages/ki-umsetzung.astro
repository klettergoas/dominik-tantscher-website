---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Button from '../components/Button.astro';
import PackageCard from '../components/PackageCard.astro';
import ValueTable from '../components/ValueTable.astro';
import page from '../content/ki-umsetzung.json';
import preise from '../content/preise.json';
---
<Base title={page.meta.title} description={page.meta.description} active="ki-umsetzung">
  <section class="section grid">
    <div class="page-hero">
      <SectionLabel>{page.hero.label}</SectionLabel>
      <h1 class="h1">{page.hero.title}</h1>
      <p class="lead page-hero__lead">{page.hero.lead}</p>
    </div>
  </section>

  <section class="section block">
    <h2 class="h2">{page.packagesTitle}</h2>
    <div class="packages">
      {preise.packages.items.map((pk, i) => (
        <PackageCard pk={pk}>
          {i === 0 && <div><Button href={page.potenzialcheckCta.href}>{page.potenzialcheckCta.label}</Button></div>}
        </PackageCard>
      ))}
    </div>
    <div class="pilot">
      <h2 class="pilot__title">{preise.pilot.title}</h2>
      <p class="pilot__text">{preise.pilot.text}</p>
    </div>
  </section>

  <section class="section block">
    <h2 class="h2">{page.maintenanceTitle}</h2>
    <div class="maintenance">
      <table class="rates">
        <thead>
          <tr><th scope="col">{preise.maintenance.headScope}</th><th scope="col">{preise.maintenance.headPrice}</th></tr>
        </thead>
        <tbody>
          {preise.maintenance.rows.map((r) => <tr><th scope="row">{r.k}</th><td>{r.v}</td></tr>)}
        </tbody>
      </table>
      <ul class="bullets">
        {preise.maintenance.bullets.map((b) => <li>{b}</li>)}
      </ul>
    </div>
  </section>

  <section class="section tables">
    <div class="good">
      <ValueTable title={page.goodToKnowTitle} rows={preise.extra.rows} note={preise.extra.note} />
      <p class="footnote">{preise.footnote}</p>
    </div>
    <ValueTable title={page.travelTitle} rows={preise.travel.rows} note={preise.travel.note} />
  </section>

  <section class="section section--flush closing">
    <Button href={page.potenzialcheckCta.href} size="lg">{page.potenzialcheckCta.label}</Button>
  </section>
</Base>

<style>
  .page-hero {
    grid-column: 1 / span 10;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .page-hero__lead { max-width: 720px; }
  .block {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .packages {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .pilot {
    border: 1px solid var(--accent);
    padding: 48px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 48px;
  }
  .pilot__title {
    font-size: 32px;
    line-height: 1.15;
    color: var(--accent);
    text-wrap: pretty;
  }
  .pilot__text {
    font-size: 18px;
    line-height: 1.6;
  }

  .maintenance {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 48px;
    align-items: start;
  }
  .rates {
    width: 100%;
    border-collapse: collapse;
    font-size: 17px;
  }
  .rates th, .rates td {
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
    font-weight: 400;
  }
  .rates thead th {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .rates tbody th { color: var(--text-2); }
  .rates td, .rates thead th:last-child { text-align: right; }
  .rates td {
    font-family: var(--font-mono);
    font-weight: 700;
    white-space: nowrap;
  }
  .bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .bullets li {
    display: flex;
    gap: 14px;
    align-items: baseline;
    font-size: 17px;
    line-height: 1.55;
  }
  .bullets li::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--accent);
    transform: translateY(-2px);
  }

  .tables {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
  }
  .good {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .footnote {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .closing { padding-bottom: 64px; }

  @media (max-width: 1139px) {
    .page-hero { grid-column: 1 / span 12; }
  }
  @media (max-width: 1023px) {
    .packages, .maintenance { grid-template-columns: minmax(0, 1fr); }
    .pilot { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  }
  @media (max-width: 767px) {
    .page-hero { gap: 24px; }
    .block { gap: 24px; }
    .pilot { padding: 28px 20px; gap: 16px; }
    .pilot__title { font-size: 24px; }
    .pilot__text { font-size: 17px; }
    .maintenance { gap: 28px; }
    .bullets li { font-size: 16px; }
    .tables { grid-template-columns: minmax(0, 1fr); gap: 56px; }
    .closing { padding-bottom: var(--sec-y); }
  }
</style>
