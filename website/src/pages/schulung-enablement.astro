---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Button from '../components/Button.astro';
import PackageCard from '../components/PackageCard.astro';
import page from '../content/schulung-enablement.json';
import preise from '../content/preise.json';
import linie2 from '../content/ki-strategie-governance.json';

// Gleiche Datenquelle wie /ki-umsetzung und /preise
const training = preise.packages.items.find((pk) => pk.n === page.smallTeams.packageNumber)!;
const org = page.organisations;
---
<Base title={page.meta.title} description={page.meta.description} active="schulung-enablement">
  <section class="section grid">
    <div class="page-hero">
      <SectionLabel>{page.hero.label}</SectionLabel>
      <h1 class="h1">{page.hero.title}</h1>
      <p class="lead page-hero__lead">{page.hero.lead}</p>
    </div>
  </section>

  <section class="section part" id={page.smallTeams.id}>
    <h2 class="h2">{page.smallTeams.title}</h2>
    <div class="part__body">
      <PackageCard pk={training}>
        <div><Button href={page.smallTeams.cta.href}>{page.smallTeams.cta.label}</Button></div>
      </PackageCard>
      <p class="footnote">{preise.footnote}</p>
    </div>
  </section>

  <section class="section section--flush part part--last" id={org.id}>
    <h2 class="h2">{org.title}</h2>
    <div class="part__body">
      <p class="org__text">{org.text}</p>
      <ul class="bullets">
        {org.items.map((item) => <li>{item}</li>)}
      </ul>
      <div class="card price-note">
        <p>{linie2.priceNote}</p>
        <div><Button href={org.cta.href} size="lg">{org.cta.label}</Button></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    grid-column: 1 / span 9;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .page-hero__lead { max-width: 720px; }

  .part {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 32px;
  }
  .part > .h2 { grid-column: 1 / span 4; }
  .part__body {
    grid-column: 5 / span 8;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .part--last { padding-bottom: 96px; }
  .footnote {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .org__text {
    font-size: var(--t-lead);
    line-height: 1.55;
  }
  .bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .bullets li {
    display: flex;
    gap: 14px;
    align-items: baseline;
    font-size: 17px;
    line-height: 1.55;
  }
  .bullets li::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--accent);
    transform: translateY(-2px);
  }
  .price-note {
    margin-top: 16px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .price-note p {
    font-size: 18px;
    line-height: 1.6;
  }

  @media (max-width: 1139px) {
    .page-hero { grid-column: 1 / span 12; }
    .part > .h2, .part__body { grid-column: 1 / span 12; }
  }
  @media (max-width: 767px) {
    .page-hero { gap: 24px; }
    .part { display: flex; flex-direction: column; gap: 24px; }
    .bullets li { font-size: 16px; }
    .price-note { padding: 28px 20px; }
    .price-note p { font-size: 17px; }
    .part--last { padding-bottom: var(--sec-y); }
  }
</style>
