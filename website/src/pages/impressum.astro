---
import Base from '../layouts/Base.astro';
import page from '../content/impressum.json';
---
<Base title={page.meta.title} description={page.meta.description}>
  <section class="grid legal-hero">
    <div class="page-hero">
      <h1 class="h1 h1--legal">{page.title}</h1>
      <p class="body">{page.intro}</p>
    </div>
  </section>

  <div class="imprint">
    <dl>
      {page.rows.map((row) => (
        <div class="imprint__row grid">
          <dt class="imprint__k">{row.k}</dt>
          <dd class="imprint__v">{row.lines.map((l) => <span>{l}</span>)}</dd>
        </div>
      ))}
    </dl>
  </div>
</Base>

<style>
  .legal-hero { padding: var(--sec-y) var(--pad-x) 64px; }
  .page-hero {
    grid-column: 1 / span 9;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .imprint { padding: 0 var(--pad-x) var(--sec-y); }
  .imprint dl { margin: 0; }
  .imprint__row {
    padding: 28px 0;
    border-top: 1px solid var(--border);
  }
  .imprint__k {
    grid-column: 1 / span 3;
    padding-top: 3px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: .18em;
    color: var(--accent);
    text-transform: uppercase;
  }
  .imprint__v {
    grid-column: 4 / span 7;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 18px;
    line-height: 1.55;
  }
  @media (max-width: 1023px) {
    .imprint__k { grid-column: 1 / span 4; }
    .imprint__v { grid-column: 5 / span 8; }
  }
  @media (max-width: 767px) {
    .legal-hero { padding-bottom: 40px; }
    .imprint__row { padding: 24px 0; gap: 8px; }
    .imprint__k { font-size: 12px; padding-top: 0; }
    .imprint__k:empty { display: none; }
    .imprint__v { font-size: 17px; }
  }
</style>
